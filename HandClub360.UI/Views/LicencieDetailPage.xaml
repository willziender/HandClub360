<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="HandClub360.UI.Views.LicencieDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
     
        <VerticalStackLayout Padding="20">
            
            <SearchBar
x:Name="RechercheSearchBar"
Placeholder="Rechercher un licencié..."
TextChanged="RechercheTextChanged" />

            <Image
                x:Name="PhotoImage"
                WidthRequest="150"
                HeightRequest="150" />

            <Label
                x:Name="NomLabel"
                FontSize="24"
                FontAttributes="Bold" />

            <Label x:Name="PrenomLabel" />

            <Label x:Name="CategorieLabel" />

            <Label x:Name="EmailLabel" />

            <Label x:Name="TelephoneLabel" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>