<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HandClub360.UI.Views.LicenciesPage">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <Label
                Text="Gestion des licenciés"
                FontSize="28"
                FontAttributes="Bold"/>

            <Image
    Source="logo_club_costieres.png"
    HeightRequest="200"
    WidthRequest="200"/>

            <Entry
    x:Name="NomEntry"
    Placeholder="Nom" />

                   
            <Entry
    x:Name="PrenomEntry"
    Placeholder="Prénom" />

            <DatePicker
    x:Name="DateNaissancePicker" />

            <Picker
    x:Name="SexePicker"
    Title="Sexe">

                <Picker.Items>
                    <x:String>M</x:String>
                    <x:String>F</x:String>
                </Picker.Items>

            </Picker>
            
            <Button
Text="Choisir une photo"
Clicked="OnChoisirPhotoClicked" />

            <Frame Padding="10"
       Margin="0,10">

                <VerticalStackLayout Spacing="5">

                    <Label
            Text="Rôles"
            FontAttributes="Bold"
            FontSize="18" />

                    <Grid ColumnDefinitions="*,*">

                        <HorizontalStackLayout Grid.Column="0">
                            <CheckBox x:Name="JoueurCheckBox"/>
                            <Label Text="Joueur"
                       VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="1">
                            <CheckBox x:Name="EntraineurCheckBox"/>
                            <Label Text="Entraîneur"
                       VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                    </Grid>

                    <Grid ColumnDefinitions="*,*">

                        <HorizontalStackLayout Grid.Column="0">
                            <CheckBox x:Name="DirigeantCheckBox"/>
                            <Label Text="Dirigeant"
                       VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="1">
                            <CheckBox x:Name="MembreCACheckBox"/>
                            <Label Text="Conseil d'administration"
                       VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                    </Grid>

                    <Grid ColumnDefinitions="*,*">

                        <HorizontalStackLayout Grid.Column="0">
                            <CheckBox x:Name="ArbitreCheckBox"/>
                            <Label Text="Arbitre"
                       VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="1">
                            <CheckBox x:Name="OfficielTableCheckBox"/>
                            <Label Text="Officiel de table"
                       VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                    </Grid>

                    <HorizontalStackLayout>
                        <CheckBox x:Name="BenevoleCheckBox"/>
                        <Label Text="Bénévole"
                   VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Frame>
            
            <Label
            x:Name="CategorieLabel"
    Text="Catégorie : non calculée"
    FontAttributes="Bold"/>

            <Entry
    x:Name="TelephoneEntry"
    Placeholder="Téléphone" />

            <Entry
    x:Name="EmailEntry"
    Placeholder="Email" />

            <Entry
    x:Name="AdresseEntry"
    Placeholder="Adresse" />

            <Entry
    x:Name="CodePostalEntry"
    Placeholder="Code Postal" />

            <Entry
    x:Name="VilleEntry"
    Placeholder="Ville" />

            <VerticalStackLayout
    x:Name="TuteurLayout"
    IsVisible="False"
    Spacing="10">

                <Label
        Text="Tuteur légal"
        FontSize="22"
        FontAttributes="Bold" />

                <Entry
        x:Name="NomTuteurEntry"
        Placeholder="Nom du tuteur" />

                <Entry
        x:Name="PrenomTuteurEntry"
        Placeholder="Prénom du tuteur" />

                <Entry
        x:Name="EmailTuteurEntry"
        Placeholder="Email du tuteur" />

                <Entry
        x:Name="TelephoneTuteurEntry"
        Placeholder="Téléphone du tuteur" />

               

            </VerticalStackLayout>

            <Button
                Text="Ajouter le licencié"
                Clicked="OnAjouterClicked"/>

            <Label
                Text="Liste des licenciés"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,20,0,0"/>

            <CollectionView
                x:Name="LicenciesCollection">

                <CollectionView.ItemTemplate>

                    <DataTemplate>
                        <Frame Margin="5"
           Padding="10">

                            <Grid ColumnDefinitions="80,*">

                                <Image
                Grid.Column="0"
                Source="{Binding PhotoPath}"
                WidthRequest="70"
                HeightRequest="70"
                Aspect="AspectFill" />

                                <VerticalStackLayout
                Grid.Column="1"
                Margin="10,0,0,0">

                                    <Label
                    Text="{Binding NomComplet}"
                    FontAttributes="Bold"
                    FontSize="18" />

                                    <Label
                    Text="{Binding Categorie}" />

                                    <Label
                    Text="{Binding Email}" />
                                    
                                    <Label
    Text="{Binding RolesAffichage}"
    FontAttributes="Italic"
    TextColor="DarkBlue" />

                                </VerticalStackLayout>

                            </Grid>

                        </Frame>
                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
    